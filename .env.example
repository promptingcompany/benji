# Server-only credentials. Never commit .env.

# Required.
OPENAI_API_KEY=
# Required unless STAGEHAND_BROWSER=local.
BROWSERBASE_API_KEY=

# Everything below is optional.
# Public-web search and extraction.
PARALLEL_API_KEY=
# Optional: the project can be inferred from the Browserbase API key.
BROWSERBASE_PROJECT_ID=
BENJI_MODEL=gpt-5.6-sol
STAGEHAND_BROWSER=browserbase
# Hosted browser logging and recording are always disabled.
# Optional browser runtime features:
# Managed proxies (1 or true). Needs a paid Browserbase plan; the free plan refuses them.
# BENJI_BROWSERBASE_PROXIES=1
# Verified Browsers (1 or true). Needs the Browserbase Enterprise plan.
# BENJI_BROWSERBASE_VERIFIED=1
# Local handoff only. For phone use, set this to Benji's deployed HTTPS origin.
BENJI_PUBLIC_URL=http://127.0.0.1:4320
BENJI_HANDOFF_SECRET=
# Optional HTTP Basic access for one trusted operator; password must be at least 32 bytes.
BENJI_OPERATOR_USERNAME=
BENJI_OPERATOR_PASSWORD=
# 1Password uses the SDK by default. Select cli explicitly for existing CLI setups.
BENJI_ONEPASSWORD_BACKEND=sdk
# SDK desktop access: sidebar account name or account UUID. CLI access: account UUID/address.
OP_ACCOUNT=
# Hosted access: a service-account token takes precedence over OP_ACCOUNT.
OP_SERVICE_ACCOUNT_TOKEN=
# Existing local encrypted vault files remain readable; no vault-writing API is provided.
BENJI_VAULT_FILE=.benji/vault.enc.json
BENJI_VAULT_MASTER_KEY=

# Baselayer sandbox. The principal must be current in the API key's organization.
BASELAYER_API_KEY=
BASELAYER_PRINCIPAL_REF=
BASELAYER_ALLOWED_ORIGINS=
