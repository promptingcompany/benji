{
	"name": "dealfinder",
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build:agent": "eve build --skip-sandbox-prewarm && node scripts/package-browser-assets.mjs",
		"build": "bun run build:agent && next build",
		"start": "next start --hostname 127.0.0.1 --port 4320",
		"test": "vitest run",
		"test:parallel:live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-parallel-research.mjs",
		"test:parallel:production": "bun run build && node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-parallel-production.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"check": "bun run test && bun run typecheck && bun run lint && bun run build",
		"baselayer:mint": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/mint-baselayer-credential.mjs",
		"test:retirement:live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-session-retirement.mjs"
	},
	"dependencies": {
		"@1password/sdk": "0.5.0",
		"@ai-sdk/openai": "4.0.46",
		"@base-ui/react": "^1.0.0",
		"@browserbasehq/sdk": "2.18.0",
		"@browserbasehq/stagehand": "4.3.0",
		"ai": "7.0.137",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"eve": "0.79.1",
		"lucide-react": "^1.16.0",
		"next": "16.4.1",
		"playwright-core": "1.62.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-markdown": "^10.1.0",
		"remark-gfm": "4",
		"tailwind-merge": "^3.3.1",
		"use-stick-to-bottom": "^1.1.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "24.19.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"just-bash": "3.6.0",
		"tailwindcss": "^4",
		"typescript": "6.0.3",
		"vitest": "4.1.12"
	},
	"license": "MIT",
	"private": true,
	"packageManager": "bun@1.4.4"
}
